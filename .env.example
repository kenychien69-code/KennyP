# ==============================================================================
# KENNY Brew Intelligence - Environment Secrets
# ==============================================================================

# SUPABASE DATABASE CREDENTIALS (Auto-sync all orders, products, inventory, users)
# Easy to connect: Paste your credentials from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key-here"

# Optional Client-side Vite environment variables (also supported directly)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-service-role-key-here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
